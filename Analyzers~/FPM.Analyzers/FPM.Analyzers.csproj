<Project Sdk="Microsoft.NET.Sdk">

  <!-- Built against Microsoft.CodeAnalysis 3.8, the newest version Unity 2021.3 can load. Build it with
       Analyzers~/build-analyzer.ps1, which copies the DLL into Runtime/Analyzers. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>FPM.Analyzers</AssemblyName>
    <RootNamespace>FPM.Analyzers</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
